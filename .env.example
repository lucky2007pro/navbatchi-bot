# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Bot ma'lumotlar bazasi fayli
DB_PATH=navbatchilik.db

# Sukut bo'yicha bildirishnoma vaqti (HH:MM formatida)
DEFAULT_NOTIFY_TIME=08:00

# Sukut bo'yicha ish kunlari:
# 'workdays' = Dushanba-Juma
# 'workdays_sat' = Dushanba-Shanba
# 'all' = Har kuni (Dushanba-Yakshanba)
DEFAULT_WORK_DAYS=workdays_sat

# Telegram Web App sozlamalari
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Lokal test uchun ngrok havolasini yoki production HTTPS havolasini yozing:
WEBAPP_URL=http://localhost:8080
